# Copy to .env.local (never commit real values). `neon deploy` fills the Neon ones automatically.

# --- Neon (written by `neon deploy` / `neon env pull`) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- App ---
ADMIN_TOKEN=
CRON_SECRET=
# mock = invented questions/results (local + demo), live = real data sources
SOURCES=mock
# set to 1 to allow SOURCES=mock in production (demo deployments only)
ALLOW_MOCK=
# ISO timestamp to simulate "now" outside production, e.g. 2026-11-15T19:30:00Z
FAKE_NOW=
